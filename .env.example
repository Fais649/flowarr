PUID=1000
PGID=1000

APP_NAME=Flowarr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Quick evaluation with SQLite (no PostgreSQL container needed):
# DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=flowarr
DB_USERNAME=sail
# DB_PASSWORD - local-dev-only default (matches compose.yaml pgsql service); not for production
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database


VITE_APP_NAME="${APP_NAME}"

SAIL_XDEBUG_MODE=develop,debug,coverage

# =============================================================================
# Additional variables referenced by config/*.php (safe local-dev defaults).
# Secrets and tokens are left empty by default. Commented-out variables only
# apply if you switch the corresponding driver (e.g. MEMCACHED, SQS, SMTP).
# =============================================================================

# --- App ---
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_STORE=database
# APP_PREVIOUS_KEYS=

# --- Auth ---
AUTH_GUARD=web
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_TIMEOUT=10800
# AUTH_MODEL=App\Models\User

# --- Database (extended) ---
DB_FOREIGN_KEYS=true
DB_CHARSET=utf8
DB_SSLMODE=prefer
# DB_URL=
# DB_SOCKET=
# DB_COLLATION=utf8mb4_unicode_ci
# MYSQL_ATTR_SSL_CA=

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_USERNAME=
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_MAX_RETRIES=3
REDIS_BACKOFF_ALGORITHM=decorrelated_jitter
REDIS_BACKOFF_BASE=100
REDIS_BACKOFF_CAP=1000
# REDIS_CLUSTER=redis
# REDIS_PERSISTENT=false
# REDIS_PREFIX=
# REDIS_URL=

# --- Cache (extended) ---
DB_CACHE_TABLE=cache
CACHE_STORAGE_PATH=framework/cache/data
# CACHE_PREFIX=
# DB_CACHE_CONNECTION=
# DB_CACHE_LOCK_CONNECTION=
# DB_CACHE_LOCK_TABLE=
# CACHE_STORAGE_DISK=
# MEMCACHED_PERSISTENT_ID=
# MEMCACHED_USERNAME=
# MEMCACHED_PASSWORD=
# MEMCACHED_HOST=127.0.0.1
# MEMCACHED_PORT=11211
# REDIS_CACHE_CONNECTION=cache
# REDIS_CACHE_LOCK_CONNECTION=default
# DYNAMODB_CACHE_TABLE=cache
# DYNAMODB_ENDPOINT=

# --- Session (extended) ---
SESSION_TABLE=sessions
SESSION_PATH=/
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=false
SESSION_PARTITIONED_COOKIE=false
# SESSION_CONNECTION=
# SESSION_STORE=
# SESSION_DOMAIN=
# SESSION_SECURE_COOKIE=

# --- Queue (named queues used by Flowarr) ---
QUEUE_TRANSCODE=transcode
QUEUE_SUBTITLE=subtitle
QUEUE_CONVERT_SUBS=convert-subs
QUEUE_DEFAULT=default
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=90
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=90
# DB_QUEUE_CONNECTION=
# BEANSTALKD_QUEUE_HOST=localhost
# BEANSTALKD_QUEUE=default
# BEANSTALKD_QUEUE_RETRY_AFTER=90
# SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
# SQS_QUEUE=default
# SQS_SUFFIX=

# --- Mail (dev default: log) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
# MAIL_SCHEME=
# MAIL_URL=
# MAIL_EHLO_DOMAIN=
# MAIL_SENDMAIL_PATH=/usr/sbin/sendmail -bs -i
# MAIL_LOG_CHANNEL=

# --- Logging (extended) ---
LOG_DAILY_DAYS=14
# LOG_DEPRECATIONS_TRACE=false
# LOG_SLACK_WEBHOOK_URL=
# LOG_SLACK_USERNAME=
# LOG_SLACK_EMOJI=:boom:
# LOG_PAPERTRAIL_HANDLER=
# PAPERTRAIL_URL=
# PAPERTRAIL_PORT=
# LOG_STDERR_FORMATTER=
# LOG_SYSLOG_FACILITY=LOG_USER

# --- Object storage (S3) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Notifications (API keys) ---
POSTMARK_API_KEY=
RESEND_API_KEY=
# SLACK_BOT_USER_OAUTH_TOKEN=
# SLACK_BOT_USER_DEFAULT_CHANNEL=

# --- Media processing ---
FFMPEG_BIN=ffmpeg
FFMPEG_USE_NVENC=true
MKVMERGE_BIN=mkvmerge
# FFMPEG_VIDEO_FILTER=     # empty = auto-detect HDR vs SDR (default null)

# --- Jellyfin webhook (optional) ---
JELLYFIN_WEBHOOK_TOKEN=

# --- Passkeys (WebAuthn) ---
# PASSKEYS_USER_HANDLE_SECRET=   # empty = defaults to APP_KEY
