# Git
.git
.gitignore
.gitattributes

# Dependencies (rebuilt in Docker)
node_modules
vendor

# Package-manager lockfiles (bun is the only package manager; these never apply)
/package-lock.json
/pnpm-workspace.yaml
/pnpm-lock.yaml
/yarn.lock

# CI & Tooling
/.github/
/.storybook/
stubs
phpunit.xml
phpstan-baseline.php
phpstan.neon
*.dist
.editorconfig
eslint.config.js
/.prettierrc
/.prettierignore

# Tests (not needed in production)
tests
/tests-frontend/
/tests-browser/
/playwright.config.ts
/vitest.config.ts

# Development environment
.env
.env.local
.env.production
# Keep .env.prod.example and .env.example (needed at runtime / first boot)
!.env.prod.example
!.env.example
docker/
!docker/prod/
openspec/
rr/
.docker

# Agent / tooling config directories
/.agents/
/.claude/
/.opencode/
/.omp/
/.pi/
/.codegraph/
/.zed/

# IDE helper files
/_ide_helper.php
/.phpstorm.meta.php

# Scratch / notes
/todo.md
/todo.txt
/draft.yaml

# Supervisor (Sail uses docker/8.5/supervisord.conf)
/supervisord.conf

# Media (mounted at runtime, never baked into the image)
/test-media/
/media/

# Documentation (not needed in runtime)
*.md
!README.md
LICENSE

# IDE
.idea
.vscode
*.swp
*.swo
*~
.DS_Store

# Build artifacts
public/hot
public/build
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
!storage/framework/.gitignore
!storage/logs/.gitignore

# SASS/CSS source maps (optional)
public/build/assets/*.map

# OS files
.DS_Store
Thumbs.db
