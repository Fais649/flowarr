parameters:
	ignoreErrors:
		-
			message: '#^Method App\\Http\\Controllers\\Config\\ScanSettingsController\:\:update\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: app/Http/Controllers/Config/ScanSettingsController.php

		-
			message: '#^Method App\\Http\\Controllers\\Config\\WorkerSettingsController\:\:update\(\) has no return type specified\.$#'
			identifier: missingType.return
			count: 1
			path: app/Http/Controllers/Config/WorkerSettingsController.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$job_id\.$#'
			identifier: property.notFound
			count: 3
			path: app/Http/Controllers/DashboardController.php

		-
			message: '#^Access to an undefined property Illuminate\\Database\\Eloquent\\Model\:\:\$library\.$#'
			identifier: property.notFound
			count: 2
			path: app/Http/Controllers/DashboardController.php

		-
			message: '#^Parameter \#1 \$callback of method Illuminate\\Database\\Eloquent\\Collection\<int,App\\Models\\Execution\>\:\:map\(\) contains unresolvable type\.$#'
			identifier: argument.unresolvableType
			count: 2
			path: app/Http/Controllers/DashboardController.php

		-
			message: '#^Return type of call to method Illuminate\\Database\\Eloquent\\Collection\<int,App\\Models\\Execution\>\:\:map\(\) contains unresolvable type\.$#'
			identifier: method.unresolvableReturnType
			count: 2
			path: app/Http/Controllers/DashboardController.php

		-
			message: '#^Unable to resolve the template type TGroupKey in call to method Illuminate\\Support\\Collection\<int,App\\Models\\Execution\>\:\:groupBy\(\)$#'
			identifier: argument.templateType
			count: 1
			path: app/Http/Controllers/DashboardController.php

		-
			message: '#^Using nullsafe property access "\?\-\>job_id" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: app/Http/Controllers/DashboardController.php

		-
			message: '#^Method App\\Http\\Controllers\\DirectoryController\:\:listDirectories\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Http/Controllers/DirectoryController.php

		-
			message: '#^Parameter \#1 \$array \(list\<array\{name\: string, path\: string, children\?\: array\}\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: app/Http/Controllers/DirectoryController.php

		-
			message: '#^Call to function in_array\(\) with string and array\{App\\ExecutionStatus\:\:QUEUED, App\\ExecutionStatus\:\:PROCESSING\} will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: app/Http/Controllers/ExecutionsController.php

		-
			message: '#^Strict comparison using \!\=\= between string and App\\ExecutionStatus\:\:FAILED will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: app/Http/Controllers/ExecutionsController.php

		-
			message: '#^Unreachable statement \- code above always terminates\.$#'
			identifier: deadCode.unreachable
			count: 2
			path: app/Http/Controllers/ExecutionsController.php

		-
			message: '#^Method App\\Http\\Requests\\ExecutionFilterRequest\:\:rules\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Http/Requests/ExecutionFilterRequest.php

		-
			message: '#^Method App\\Http\\Requests\\StoreLibraryRequest\:\:rules\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Http/Requests/StoreLibraryRequest.php

		-
			message: '#^Method App\\Http\\Requests\\UpdateLibraryRequest\:\:rules\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Http/Requests/UpdateLibraryRequest.php

		-
			message: '#^Method App\\Http\\Requests\\UpdateScanSettingsRequest\:\:rules\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Http/Requests/UpdateScanSettingsRequest.php

		-
			message: '#^Method App\\Http\\Requests\\UpdateWorkerSettingsRequest\:\:rules\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Http/Requests/UpdateWorkerSettingsRequest.php

		-
			message: '#^Trait App\\Jobs\\Concerns\\HasPauseAndConcurrency is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: app/Jobs/Concerns/HasPauseAndConcurrency.php

		-
			message: '#^Left side of && is always true\.$#'
			identifier: booleanAnd.leftAlwaysTrue
			count: 1
			path: app/Jobs/ConvertSubtitleJob.php

		-
			message: '#^Variable \$outputFile in isset\(\) always exists and is not nullable\.$#'
			identifier: isset.variable
			count: 1
			path: app/Jobs/ExtractSubtitlesJob.php

		-
			message: '#^Parameter \#2 \$callback of function array_filter expects \(callable\(string\)\: bool\)\|null, Closure\(mixed\)\: \(0\|1\|false\) given\.$#'
			identifier: argument.type
			count: 1
			path: app/Jobs/TranscodeMediaJob.php

		-
			message: '#^Class App\\Models\\Execution uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types\: TFactory$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/Execution.php

		-
			message: '#^Method App\\Models\\Execution\:\:libraryJob\(\) return type with generic class Illuminate\\Database\\Eloquent\\Relations\\BelongsTo does not specify its types\: TRelatedModel, TDeclaringModel$#'
			identifier: missingType.generics
			count: 1
			path: app/Models/Execution.php

		-
			message: '#^PHPDoc type array of property App\\Models\\Execution\:\:\$fillable is not covariant with PHPDoc type list\<string\> of overridden property Illuminate\\Database\\Eloquent\\Model\:\:\$fillable\.$#'
			identifier: property.phpDocType
			count: 1
			path: app/Models/Execution.php

		-
			message: '#^Property App\\Models\\Execution\:\:\$fillable type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Models/Execution.php

		-
			message: '#^Type App\\Models\\JobWorkerLimit in generic type Illuminate\\Database\\Eloquent\\Factories\\HasFactory\<App\\Models\\JobWorkerLimit\> in PHPDoc tag @use is not subtype of template type TFactory of Illuminate\\Database\\Eloquent\\Factories\\Factory of trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory\.$#'
			identifier: generics.notSubtype
			count: 1
			path: app/Models/JobWorkerLimit.php

		-
			message: '#^Missing parameter \$fileExtension \(string\) in call to App\\Services\\MediaProbeResult constructor\.$#'
			identifier: argument.missing
			count: 1
			path: app/Services/MediaProbeService.php

		-
			message: '#^Unknown parameter \$extension in call to App\\Services\\MediaProbeResult constructor\.$#'
			identifier: argument.unknown
			count: 1
			path: app/Services/MediaProbeService.php

		-
			message: '#^Call to an undefined method App\\Jobs\\Contracts\\DispatchableJob&Illuminate\\Contracts\\Queue\\ShouldQueue\:\:setExecutionId\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Services/ScannerService.php

		-
			message: '#^Call to an undefined method App\\Services\\MediaProbeResult\:\:hasEmbeddedSubtitles\(\)\.$#'
			identifier: method.notFound
			count: 1
			path: app/Services/ScannerService.php

		-
			message: '#^Method App\\Services\\ScannerService\:\:collectMediaFiles\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/ScannerService.php

		-
			message: '#^Method App\\Settings\:\:all\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Settings.php

		-
			message: '#^Trait App\\Traits\\HasJobSlot is used zero times and is not analysed\.$#'
			identifier: trait.unused
			count: 1
			path: app/Traits/HasJobSlot.php

		-
			message: '#^Array has 2 duplicate keys with value ''iku'' \(''iku'', ''iku''\)\.$#'
			identifier: array.duplicateKey
			count: 1
			path: config/languages.php

		-
			message: '#^Class Database\\Factories\\ExecutionFactory extends generic class Illuminate\\Database\\Eloquent\\Factories\\Factory but does not specify its types\: TModel$#'
			identifier: missingType.generics
			count: 1
			path: database/factories/ExecutionFactory.php

		-
			message: '#^Class Database\\Factories\\LibraryFactory extends generic class Illuminate\\Database\\Eloquent\\Factories\\Factory but does not specify its types\: TModel$#'
			identifier: missingType.generics
			count: 1
			path: database/factories/LibraryFactory.php

		-
			message: '#^Class Database\\Factories\\LibraryJobFactory extends generic class Illuminate\\Database\\Eloquent\\Factories\\Factory but does not specify its types\: TModel$#'
			identifier: missingType.generics
			count: 1
			path: database/factories/LibraryJobFactory.php

		-
			message: '#^Class Database\\Factories\\WorkerFactory extends generic class Illuminate\\Database\\Eloquent\\Factories\\Factory but does not specify its types\: TModel$#'
			identifier: missingType.generics
			count: 1
			path: database/factories/WorkerFactory.php
