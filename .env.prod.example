# =============================================================================
# Flowarr — Self-hosted media library file transformation automation
# =============================================================================
# Copy this file to .env and fill in the required values.
# All variables with "(required)" MUST be set before running docker compose up.
# =============================================================================

# --- REQUIRED ---
PUID=1000
PGID=1000

# APP_KEY (required) — Encryption key for sessions, cookies, and encrypted data.
# Generate with: openssl rand -base64 32
# If left empty, one will be auto-generated on first start (sessions lost on restart).
APP_KEY=

# DB_PASSWORD (required) — PostgreSQL database password.
# Choose a strong, random password.
DB_PASSWORD=

# --- APPLICATION ---

# APP_NAME — Application name. Used in emails and notifications.
APP_NAME=Flowarr

# APP_URL — Public URL of your Flowarr instance.
# Used for link generation in emails and notifications.
APP_URL=https://your-domain.example.com

# APP_ENV — Application environment. Keep "production" for self-hosted deployments.
APP_ENV=production

# APP_DEBUG — Show detailed error pages. Keep "false" in production.
APP_DEBUG=false

# RUN_MIGRATIONS — Automatically run database migrations on container start.
# Set to "true" for first-time setup, "false" to skip.
RUN_MIGRATIONS=true

# LOG_LEVEL — Minimum log level. Options: debug, info, notice, warning, error, critical, alert, emergency
LOG_LEVEL=warning

# --- DATABASE (PostgreSQL) ---

DB_CONNECTION=pgsql
DB_HOST=flowarr-postgres
DB_PORT=5432
DB_DATABASE=flowarr
DB_USERNAME=flowarr
# DB_PASSWORD set above (required)

# --- REDIS (Cache & Sessions) ---

REDIS_HOST=flowarr-redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# --- TRAEFIK (Reverse Proxy) ---

# DOMAIN — Domain for Traefik routing. Must match your DNS record pointing at your Docker host.
# Used in Host() rule for Traefik router.
DOMAIN=your-domain.example.com

# TRAEFIK_NETWORK — External Docker network that Traefik is attached to.
# The flowarr container will join this network for Traefik to route to it.
# Default: traefik
TRAEFIK_NETWORK=traefik

# --- MEDIA ---

# MEDIA_PATH — Path to your media library on the host filesystem.
# Default: ./media (relative to docker-compose.yml)
MEDIA_PATH=./media

# --- SESSION ---

SESSION_DRIVER=database
SESSION_LIFETIME=120

# --- QUEUE ---

QUEUE_CONNECTION=database
CACHE_STORE=redis

# --- LOCALE ---

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- STORAGE ---

FILESYSTEM_DISK=local
